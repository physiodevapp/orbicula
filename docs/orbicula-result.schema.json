{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbicula.invalid/schema/result/1",
  "title": "orbicula · resultado (schemaVersion 1)",
  "description": "JSON público de resultados de orbicula. Tiempos en milisegundos desde el inicio de la grabación. Lados siempre del paciente. Documentado en docs/schema.md.",
  "type": "object",
  "required": ["app", "appVersion", "schemaVersion", "createdAt", "participantCode", "capture", "protocol", "calibration", "metrics", "quality", "events", "timeseries"],
  "additionalProperties": false,
  "properties": {
    "app": { "const": "orbicula" },
    "appVersion": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "1" },
    "createdAt": { "type": "string", "format": "date-time" },
    "participantCode": { "type": ["string", "null"], "maxLength": 24 },
    "capture": {
      "type": "object",
      "required": ["source", "analysis", "camera", "fps", "width", "height", "mirrored"],
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["live", "file"], "description": "live: la cámara de la app; file: un vídeo grabado con otra app." },
        "analysis": { "enum": ["live", "frame-by-frame"], "description": "live: en directo; frame-by-frame: vídeo analizado fotograma a fotograma." },
        "camera": { "enum": ["rear", "front", null] },
        "fps": { "type": ["number", "null"], "minimum": 0 },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "height": { "type": ["integer", "null"], "minimum": 1 },
        "mirrored": { "type": "boolean", "description": "La imagen analizada iba en espejo (y los lados ya están corregidos)." }
      }
    },
    "protocol": {
      "type": "array",
      "description": "Fases hechas, con su inicio y fin en ms.",
      "items": {
        "type": "object",
        "required": ["phase", "start", "end"],
        "additionalProperties": false,
        "properties": {
          "phase": { "$ref": "#/$defs/phase" },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "calibration": {
      "description": "Calibración sobre el reposo, o null si no hubo reposo.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["valid", "reason", "thresholds", "earBaseline", "headStill", "warnings"],
          "additionalProperties": false,
          "properties": {
            "valid": { "type": "boolean" },
            "reason": { "type": ["string", "null"] },
            "thresholds": { "$ref": "#/$defs/perSideNumber", "description": "Umbral de los eventos: subida del cierre por flujo, en distancias intercantales (DI)." },
            "earBaseline": { "$ref": "#/$defs/perSideNumber", "description": "EAR en reposo." },
            "headStill": { "type": ["number", "null"], "description": "Velocidad del dorso nasal por debajo de la cual la cabeza está quieta, en DI/s." },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "metrics": {
      "type": "object",
      "required": ["left", "right", "asymmetry"],
      "additionalProperties": false,
      "properties": {
        "left": { "$ref": "#/$defs/metricsBySide" },
        "right": { "$ref": "#/$defs/metricsBySide" },
        "asymmetry": { "$ref": "#/$defs/metricsBySide", "description": "(I − D) / (I + D), solo de las magnitudes positivas." }
      }
    },
    "quality": {
      "type": "object",
      "description": "Calidad de cada fase.",
      "propertyNames": { "$ref": "#/$defs/phase" },
      "additionalProperties": {
        "type": "object",
        "required": ["reliable", "faceFraction", "headMoving", "analysisFps", "notes"],
        "additionalProperties": false,
        "properties": {
          "reliable": { "type": "boolean" },
          "faceFraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "headMoving": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "analysisFps": { "type": ["number", "null"], "minimum": 0 },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "events": {
      "type": "array",
      "description": "Contracciones finas (con su estado) y parpadeos / cierres, en orden de tiempo.",
      "items": {
        "type": "object",
        "required": ["phase", "side", "kind", "status", "t", "duration"],
        "additionalProperties": false,
        "properties": {
          "phase": { "$ref": "#/$defs/phase" },
          "side": { "enum": ["left", "right"] },
          "kind": { "enum": ["contraction", "blink", "closure", "narrowing"] },
          "status": { "enum": ["ok", "head", "blink", "brief"], "description": "ok: cuenta; head: descartada por mover la cabeza; blink: era un parpadeo; brief: dura menos de 0,5 s." },
          "t": { "type": "integer", "minimum": 0 },
          "duration": { "type": "number", "minimum": 0 },
          "peak": { "type": ["number", "null"], "description": "Solo contracciones: pico, en veces el umbral." },
          "completeness": { "type": ["number", "null"], "description": "Solo parpadeos y cierres: cierre respecto al reposo, de 0 a 1." }
        }
      }
    },
    "timeseries": {
      "type": "object",
      "description": "Señales de la cara de todas las fases, en un solo eje de tiempo (con huecos entre fases). Todos los arrays tienen la longitud de `t`.",
      "required": ["t", "phase", "left", "right"],
      "additionalProperties": false,
      "properties": {
        "t": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "phase": { "type": "array", "items": { "$ref": "#/$defs/phase" } },
        "left": { "$ref": "#/$defs/seriesBySide" },
        "right": { "$ref": "#/$defs/seriesBySide" }
      }
    }
  },
  "$defs": {
    "phase": { "enum": ["rest", "natural", "soft", "forced", "brows", "smile", "free"], "description": "rest: reposo; natural: parpadeo espontáneo; soft: cierre suave; forced: cierre forzado; brows: elevación de cejas; smile: sonrisa amplia; free: resto de un vídeo grabado." },
    "nullableNumber": { "type": ["number", "null"] },
    "perSideNumber": {
      "type": "object",
      "required": ["left", "right"],
      "additionalProperties": false,
      "properties": { "left": { "type": ["number", "null"] }, "right": { "type": ["number", "null"] } }
    },
    "metricsBySide": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/phase" },
      "additionalProperties": {
        "type": "object",
        "description": "Métricas de una fase. Los nombres y unidades están en docs/schema.md; puede faltar cualquiera.",
        "additionalProperties": { "type": ["number", "boolean", "null"] }
      }
    },
    "seriesBySide": {
      "type": "object",
      "required": ["ear", "aperture", "blink", "smile", "closure"],
      "additionalProperties": false,
      "properties": {
        "ear": { "type": "array", "items": { "$ref": "#/$defs/nullableNumber" }, "description": "EAR." },
        "aperture": { "type": "array", "items": { "$ref": "#/$defs/nullableNumber" }, "description": "Apertura palpebral / distancia intercantal." },
        "blink": { "type": "array", "items": { "$ref": "#/$defs/nullableNumber" }, "description": "Blendshape de parpadeo (0 abierto, 1 cerrado)." },
        "smile": { "type": "array", "items": { "$ref": "#/$defs/nullableNumber" }, "description": "Blendshape de sonrisa de ese lado (0–1)." },
        "closure": { "type": "array", "items": { "$ref": "#/$defs/nullableNumber" }, "description": "Cierre por flujo (DI, + = se cierra), de la muestra de flujo más cercana (≤ 40 ms), o null." }
      }
    }
  }
}
