# Privacidad: la CSP solo deja hablar a la página con su propio origen (ninguna llamada externa).
# Las fases con MediaPipe/OpenCV añadirán 'wasm-unsafe-eval' a script-src.
# frame-ancestors permite que el hub PhysiQ la cargue en un iframe.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self' https://physiodevapp.github.io

# Vite pone un hash en el nombre de estos archivos: si cambian, cambia el nombre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
